// QuantBench in GitHub Codespaces (or any Dev Containers host).
//
//   Open in Codespaces -> the first start installs PyTorch (CPU build), the packages and the two 0.5B models
//   (about 4 minutes) -> QuantBench opens in a browser tab on port 8000. Later starts take seconds.
//
// No login, no key, nothing on the laptop. Everything (the server, the models, the generated code that the
// grader executes) runs inside the codespace. Port 8000 is private to the codespace's owner: GitHub
// authenticates the browser before a request reaches the server.
//
// Codespaces have no GPU: the defaults are Qwen2.5-Coder-0.5B-Instruct in FP32 (slot A) against the same
// model in optimum-quanto INT8 (slot B), which fit in a few GB of RAM and decode at a few tokens per second.
{
  "name": "QuantBench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "containerEnv": { "PYTHONUNBUFFERED": "1", "HF_HUB_DISABLE_PROGRESS_BARS": "1" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "QuantBench", "onAutoForward": "openBrowser", "requireLocalPort": false }
  },
  "customizations": {
    "codespaces": { "openFiles": ["CODESPACES.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
